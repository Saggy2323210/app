# The .vscode folder contains configureation for the Visual Studio Code editor.
.vscode/

# The .dart_tool folder is used by Dart tools like pub, analyzer, and test.
.dart_tool/

# The pubspec.lock file prevents pub from determining what the best versions of
# dependencies are when someone else clones the project and runs `pub get`.
pubspec.lock

# The build/ folder contains generated files and should not be checked in.
build/

# Flutter related
.flutter-plugins
.flutter-plugins-dependencies

